---
# Kubeconfig Secret for Agent to Access Triage Cluster
# This example creates a kubeconfig for self-triage (agent accesses the kind cluster itself)
# Copy this file to kubeconfig-secret.yaml and customize as needed
# DO NOT commit kubeconfig-secret.yaml to git (it's in .gitignore)

apiVersion: v1
kind: Secret
metadata:
  name: kubeconfig-nightcrier-dev
  namespace: nightcrier
  labels:
    app: nightcrier
    component: agent-runner
    cluster: nightcrier-dev
type: Opaque
stringData:
  # The kubeconfig file that agents will use to access the cluster
  # For self-triage in kind: use the kind cluster's kubeconfig
  # For remote clusters: use appropriate kubeconfig with limited permissions
  config: |
    apiVersion: v1
    kind: Config
    clusters:
      - cluster:
          certificate-authority-data: YOUR_CA_DATA_HERE
          server: https://kubernetes.default.svc
        name: nightcrier-dev
    contexts:
      - context:
          cluster: nightcrier-dev
          user: nightcrier-agent
        name: nightcrier-dev
    current-context: nightcrier-dev
    users:
      - name: nightcrier-agent
        user:
          token: YOUR_SERVICE_ACCOUNT_TOKEN_HERE

---
# Instructions for creating a proper kubeconfig:
#
# For self-triage (agent troubleshoots the kind cluster itself):
# 1. Create a ServiceAccount in the target namespace with read-only permissions
# 2. Get the token: kubectl create token <serviceaccount> -n <namespace>
# 3. Get cluster CA: kubectl config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}'
# 4. Use server: https://kubernetes.default.svc (from within cluster)
#
# For external clusters:
# 1. Export kubeconfig: kubectl config view --flatten --minify > cluster-config.yaml
# 2. Create secret: kubectl create secret generic kubeconfig-<cluster-name> \
#      --from-file=config=cluster-config.yaml -n nightcrier
#
# Convention: Secret name MUST be "kubeconfig-<cluster-name>"
# The executor looks for secrets with this pattern
